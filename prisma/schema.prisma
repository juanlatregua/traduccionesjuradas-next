generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  IN_PROGRESS
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  REDSYS
  PAYPAL
  BIZUM
  TRANSFER
  STRIPE
}

enum DeliveryState {
  PRESUPUESTO
  EN_PROCESO
  TRADUCIDO
}

enum QuoteStatus {
  DRAFT
  SENT
  OPENED
  ACCEPTED
  PAID
  IN_PROGRESS
  DELIVERED
  EXPIRED
}

enum QuoteDeliveryType {
  DIGITAL_PDF
  PAPER_SHIP
}

enum QuoteDiscountType {
  NONE
  PERCENT
  FIXED
}

enum QuotePaymentProvider {
  STRIPE
  PAYPAL
  BIZUM
  TRANSFER
  OTHER
}

enum QuoteMessageChannel {
  EMAIL
  WHATSAPP
  SMS
}

enum QuoteMessageType {
  PAY_LINK
  REMINDER
  PAID_CONFIRMATION
  DRAFT_WHATSAPP
  EXPIRED_NOTICE
  RESEND_PAY_LINK
  TRANSLATOR_REVIEW_OFFER
  INBOX_REPLY
  MARGIN_OVERRIDE
}

enum QuoteAccessEventType {
  OPENED
}

// Motivo por el que un presupuesto enviado no se convirtió (lo da el cliente).
enum QuoteLostReason {
  PRICE
  DEADLINE
  NO_LONGER_NEEDED
  SOLVED_ELSEWHERE
  OTHER
}

enum SessionStep {
  START
  UPLOAD
  REVIEW
  CHECKOUT
  CONFIRMATION
}

enum AuthState {
  GUEST
  AUTHENTICATED
}

model Order {
  id                 String         @id @default(cuid())
  reference          String         @unique
  idempotencyKey     String?        @unique
  clientEmail        String
  clientName         String?
  clientPhone        String?
  clientLocale       String?        @default("es") // idioma del cliente (es|fr) para SMS/email/UI
  clientNotes        String?
  source             String
  title              String
  langPair           String?
  words              Int?
  pagesLabel         String?
  amountCents        Int
  currency           String         @default("eur")
  status             OrderStatus    @default(PENDING_PAYMENT)
  paymentStatus      PaymentStatus  @default(PENDING)
  paymentMethod      PaymentMethod?
  externalPaymentId  String?
  deliveryState      DeliveryState  @default(PRESUPUESTO)
  deliveryType       String         @default("pdf")
  translatedFileUrl  String?
  quotePreviewFileKey String?
  quotePreviewFileUrl String?
  quoteSnapshotJson   Json?
  paymentProofFileKey String?
  finalDeliveryFileKey String?
  finalDeliveryFileUrl String?
  finalFilename       String?
  finalMimeType       String?
  deliveryFilesJson  Json?          // entrega MULTI-archivo A NIVEL PEDIDO: [{url, fileKey?, filename?, mimeType?}]; translatedFileUrl = el primero (compat). Distinto de OrderDocumentItem.deliveredFileUrl (por documento) y del assignment del colaborador.
  trackingNumber     String?        // envío en papel (deliveryType "paper"): nº de seguimiento de la mensajería
  shippedAt          DateTime?      // cuándo se notificó el envío al cliente
  // TRÁMITE: agrupa N pedidos del mismo cliente que son UN solo encargo para él
  // (fue añadiendo documentos y cada uno nació como pedido propio). Formato
  // TRAM-XXXXXX. NO es expedienteRef (ese es el lote de ENTRADA, 1 lote → 1
  // presupuesto, y compartirlo entre pedidos duplicaría los OrderDocumentItem
  // en populateOrderItemsFromQuote). Cada pedido sigue cobrándose y facturándose
  // por separado: el trámite solo agrupa envío, vista de cliente y coste.
  caseRef            String?
  assignedTo         String?
  translatorUploadToken String?     @unique
  translatorDeliveredAt DateTime?
  dueDate            DateTime?
  supplierCostCents  Int?
  marginPct          Int?           @default(25)
  quoteState         String?
  quoteId            String?
  draftFileKey       String?
  draftFileUrl       String?
  draftGeneratedAt   DateTime?
  draftFilename      String?
  draftContentJson   String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  paidAt             DateTime?
  // Excluido del listado de facturación oficial (apartado aparte, reversible):
  // pruebas, reembolsos, duplicados o cobros no confirmados en banco. Mientras
  // esté excluido NO aparece en "pendientes de facturar" ni se factura.
  billingExcluded       Boolean   @default(false)
  billingExcludedReason String?

  quote    Quote?         @relation(fields: [quoteId], references: [id])
  events   OrderEvent[]
  paymentEvents OrderPaymentEvent[]
  billing  BillingData?
  shipping ShippingData?
  documentAnalyses DocumentAnalysis[]
  collaboratorAssignments CollaboratorAssignment[]
  documentItems    OrderDocumentItem[]
  clientInvoice    ClientInvoice?

  @@index([clientEmail])
  @@index([createdAt])
  @@index([paymentStatus, status])
  @@index([caseRef])
}

// Documentos individuales de un pedido (expediente). Poblado por el puente
// Quote→Pedido a partir del expediente del cliente o de las líneas del
// presupuesto. Permite ver/seguir un pedido grande documento a documento.
// Aditivo: no altera el flujo de entrega monolítico existente.
model OrderDocumentItem {
  id               String    @id @default(cuid())
  orderId          String
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fileName         String
  fileUrl          String?
  documentType     String?
  sourceLang       String?
  targetLang       String?
  words            Int?
  quotedCents      Int?
  prodStatus       String    @default("PENDING") // PENDING | IN_TRANSLATION | DELIVERED
  assignedTo       String?
  deliveredFileUrl String?
  deliveredAt      DateTime?
  createdAt        DateTime  @default(now())

  @@index([orderId])
}

// Factura emitida al cliente con numeración fiscal secuencial y persistencia.
// Sustituye el "F-{ref}" generado al vuelo (sin valor legal).
model ClientInvoice {
  id            String    @id @default(cuid())
  number        String?   @unique // AA_NNN secuencial; null mientras es BORRADOR
  status        String    @default("DRAFT") // DRAFT | ISSUED
  docKind       String    @default("invoice") // invoice | quote — los "presupuestos" emitidos por este módulo comparten la serie AA_NNN pero NO son facturas: quedan fuera de contabilidad/303/gestoría
  simplified    Boolean   @default(false) // factura simplificada (≤400€, sin NIF del cliente; RD 1619/2012)
  origin        String? // auditoría: lazy_pdf | reconcile_batch | manual | import | draft
  brand         String    @default("traduccionesjuradas") // marca/actividad emisora (numeración compartida)
  orderId       String?   @unique // null = factura libre (sin pedido)
  order         Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  issuedAt      DateTime? // se sella al emitir
  // Vencimiento pactado del cobro aplazado. Solo lo escribe /authorize-credit
  // (ADMIN/PM). dueDate != null ES la marca del carril de credito: no hay flag
  // en Order. Lo protege la serie fiscal, no un booleano que se copia por ahi.
  dueDate       DateTime?
  paidAt        DateTime? // cobrada: se sella al vincular un ingreso bancario o al adjuntar el justificante
  // Justificante bancario del pago (Vercel Blob). Adjuntarlo sella paidAt vía setInvoicePaid.
  paymentProofUrl  String?
  paymentProofKey  String?
  paymentProofName String?
  holderNames   String? // titulares de los certificados (p.ej. clientes de Auream) — solo informativo
  clientName    String? // nombre comercial / referencia interna (opcional)
  fiscalName    String
  nif           String?
  address       String?
  city          String?
  postalCode    String?
  country       String    @default("España")
  email         String?
  concept       String? // título general para el PDF (opcional)
  poNumber      String? // Purchase Order / nº de pedido del cliente (p.ej. Oracle)
  langPair      String?
  lineItemsJson Json? // [{ description, detail?, amountCents }] (base sin IVA)
  baseCents     Int
  vatRate       Float     @default(0.21)
  vatCents      Int
  totalCents    Int
  // ── VeriFactu (RD 1007/2023) ───────────────────────────────────────────────
  // El EMISOR es un dato, no una marca: en lavori cada jurado es su propio
  // obligado (NIF, serie, numeración). Aquí hoy siempre es la S.L.
  emitterNif    String?
  // TipoFactura del registro: F1 completa, F2 simplificada, R1..R5 rectificativa.
  invoiceType   String    @default("F1")
  // Rectificativa: id y número de la factura que rectifica (R1). Sin relación
  // Prisma a propósito: es una referencia fiscal, no navegación.
  rectifiesId   String?
  rectifiesNumber String?
  // Anulada mediante registro de anulación (la fila NO se borra nunca).
  annulledAt    DateTime?
  records       InvoiceRecord[]
  events        InvoiceEvent[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@index([issuedAt])
  @@index([status])
  @@index([dueDate])
  @@index([rectifiesId])
}

// REGISTRO DE FACTURACIÓN (RD 1007/2023 art. 8-11): uno por alta y otro por
// anulación, encadenados por emisor con la huella SHA-256 del anterior
// (lib/verifactu/hash.ts reproduce el ejemplo oficial de la AEAT). Inmutable:
// no hay update de contenido ni delete en el código; corregir = nuevo registro.
model InvoiceRecord {
  id            String   @id @default(cuid())
  invoiceId     String
  invoice       ClientInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  kind          String   // ALTA | ANULACION
  emitterNif    String
  chainIndex    Int      // posición en la cadena de ESTE emisor (1..n)
  numSerie      String
  issueDate     String   // dd-mm-aaaa tal cual va en la cadena
  invoiceType   String   // F1 | F2 | R1..R5 (vacío en anulación)
  cuotaTotalCents   Int
  importeTotalCents Int
  prevHash      String?
  hash          String   @unique
  canonical     String   // cadena hasheada, para verificar sin recomputar formatos
  generatedAt   DateTime
  generatedAtIso String  // FechaHoraHusoGenRegistro exactamente como se hasheó
  // Envío a la AEAT (modalidad VERI*FACTU, vía proveedor colaborador social):
  // LOCAL = sin proveedor configurado (cadena solo interna) · PENDING = en cola
  // · SENT · ACCEPTED · ACCEPTED_WITH_ERRORS · REJECTED
  sendStatus    String   @default("LOCAL")
  provider      String?
  providerRef   String?
  providerResponse Json?
  sentAt        DateTime?
  acceptedAt    DateTime?
  createdAt     DateTime @default(now())
  @@unique([emitterNif, chainIndex])
  @@index([invoiceId])
  @@index([sendStatus])
}

// REGISTRO DE EVENTOS del sistema de facturación (RD 1007/2023 art. 8.2 y
// Orden HAC/1177/2024): quién hizo qué y cuándo sobre cada factura. Solo inserta.
model InvoiceEvent {
  id         String   @id @default(cuid())
  invoiceId  String?
  invoice    ClientInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  type       String   // invoice.issued | record.alta | record.sent | record.accepted | record.rejected | invoice.paid | invoice.rectified | invoice.annulled | draft.deleted | invoice.imported | issue.attempt_on_issued
  actor      String?  // email del staff o "system"
  message    String?
  payload    Json?
  at         DateTime @default(now())
  @@index([invoiceId])
  @@index([type])
  @@index([at])
}

// Gasto manual del libro de contabilidad (IVA soportado). No ligado a pedidos:
// el traductor lo introduce a mano o lo importa. Fuente principal de gastos.
model Expense {
  id                    String   @id @default(cuid())
  date                  DateTime // fecha del gasto/factura recibida
  brand                 String   @default("traduccionesjuradas")
  supplier              String? // proveedor
  supplierNif           String?
  supplierInvoiceNumber String? // nº de factura del proveedor (libro de recibidas)
  concept               String
  category              String? // p.ej. software, suministros, colaborador, cuota
  baseCents             Int
  vatRate               Float    @default(0.21)
  vatCents              Int // IVA soportado
  ivaDeducible          Boolean  @default(true) // false = no deducible (atenciones, comidas… art. 96 LIVA)
  taxTreatment          String   @default("general") // general | isp_intracom | isp_import | exempt
  needsReview           Boolean  @default(false)
  irpfRetentionPct      Float    @default(0) // retención IRPF de colaboradores (modelo 111/190)
  irpfCents             Int      @default(0)
  totalCents            Int // base + IVA (importe de la factura)
  payableCents          Int? // base + IVA − IRPF (lo que se transfiere al proveedor)
  paidAt                DateTime? // pagado: se sella al vincular un cargo bancario
  paymentStatus         String   @default("PENDING") // PENDING | PAID
  attachmentUrl         String? // justificante (Vercel Blob)
  attachmentKey         String?
  attachmentName        String?
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @default(now()) @updatedAt

  // Cuenta corriente por colaborador: el gasto auto-creado al adjudicar un encargo
  // es un DEVENGO interno (isAccrual) — pendiente de la factura real del traductor,
  // fuera de libro/303/gestoría/banco. Al registrar la factura del mes, los devengos
  // se sellan con settledById (la factura recibida que los absorbe).
  collaboratorId String?
  collaborator   Collaborator? @relation(fields: [collaboratorId], references: [id], onDelete: SetNull)
  orderReference String? // pedido que originó el devengo
  isAccrual      Boolean       @default(false)
  settledById    String?
  settledBy      Expense?      @relation("ExpenseSettlement", fields: [settledById], references: [id], onDelete: SetNull)
  settles        Expense[]     @relation("ExpenseSettlement")

  // Sin @@unique(supplierNif, supplierInvoiceNumber): en PG los NULL no colisionan
  // (los SaaS sin NIF quedarían fuera) y bloquearía el "guardar de todas formas"
  // legítimo (una factura partida en 2 apuntes). La guarda es assertNotDuplicate.
  @@index([date])
  @@index([supplierNif, supplierInvoiceNumber])
  @@index([supplierNif])
  @@index([isAccrual, settledById])
  @@index([collaboratorId])
}

// Plantilla de gasto recurrente (espejo de RecurringInvoice): el cron genera un
// borrador cada mes. amountCents null = importe variable (se completa a mano).
model RecurringExpense {
  id                  String   @id @default(cuid())
  label               String
  active              Boolean  @default(true)
  brand               String   @default("traduccionesjuradas")
  supplier            String?
  supplierNif         String?
  category            String?
  conceptTemplate     String // admite {MES} {AÑO}
  lineItemsJson       Json? // multi-apunte: [{ concept, baseCents, vatRate, ivaDeducible?, taxTreatment? }] (caso Orange)
  vatRate             Float    @default(0.21)
  taxTreatment        String   @default("general") // general | isp_intracom | isp_import | exempt
  irpfRetentionPct    Float    @default(0)
  amountCents         Int? // null = importe variable
  dayOfMonth          Int      @default(1)
  lastGeneratedPeriod String? // "YYYY-MM"
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([active])
}

// Decisiones del staff sobre líneas del extracto bancario. NO almacena el extracto
// crudo (sin importe, concepto, contraparte ni saldo) → privacidad por diseño y sin
// "libro de caja" paralelo sumable. lineHash = SHA-256(fecha|importe|concepto-norm)
// recalculado en cada subida y cruzado contra esta tabla.
// Plantilla de factura recurrente (p.ej. la cuota mensual de clases de Oracle).
// El cron genera un BORRADOR cada mes; nunca emite (la numeración correlativa y el
// sellado son acto manual). lastGeneratedPeriod evita duplicar el mismo mes.
model RecurringInvoice {
  id                     String   @id @default(cuid())
  label                  String
  active                 Boolean  @default(true)
  brand                  String   @default("traduccionesjuradas")
  clientName             String?
  fiscalName             String
  nif                    String?
  address                String?
  city                   String?
  postalCode             String?
  country                String   @default("España")
  email                  String?
  conceptTemplate        String? // admite {MES} {AÑO} {MES_AÑO}
  poNumber               String?
  langPair               String?
  lineItemsJson          Json? // [{ description, detail?, amountCents }] (base sin IVA)
  vatRate                Float    @default(0.21)
  dayOfMonth             Int      @default(1)
  lastGeneratedPeriod    String? // "YYYY-MM"
  lastGeneratedInvoiceId String?
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @default(now()) @updatedAt

  @@index([active])
}

model BankDecision {
  id          String   @id @default(cuid())
  brand       String   @default("traduccionesjuradas")
  lineHash    String   @unique
  status      String // IGNORED | MATCHED_MANUAL
  matchedType String? // invoice | order | expense (solo si MATCHED_MANUAL)
  matchedId   String?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([brand])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  type      String
  message   String
  payload   Json?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model OrderPaymentEvent {
  id              String        @id @default(cuid())
  orderId          String
  provider         PaymentMethod
  providerEventId  String
  idempotencyKey   String        @unique
  source           String
  payload          Json?
  createdAt        DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([provider, providerEventId])
}

model BillingData {
  id         String    @id @default(cuid())
  orderId    String    @unique
  fiscalName String
  nif        String
  address    String
  city       String
  postalCode String
  country    String    @default("España")
  email      String
  requested  Boolean   @default(false)
  notifiedAt DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model ShippingData {
  id         String @id @default(cuid())
  orderId    String @unique
  name       String
  phone      String
  address    String
  city       String
  province   String
  postalCode String
  country    String @default("España")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  // Pack fiscal del cliente (B2B recurrente, p.ej. Auream). Antes solo vivía
  // suelto en cada ClientInvoice; aquí es la ficha del cliente para el portal.
  companyName String?
  nif         String?
  fiscalName  String?
  address     String?
  city        String?
  postalCode  String?
  country     String?  @default("España")
  notes       String?
  isBusiness  Boolean  @default(false)
  // Cliente de confianza (B2B recurrente, p.ej. Auream): al subir el justificante
  // de transferencia se auto-confirma el pago y se emite la factura, sin esperar a
  // que el staff verifique en el banco. Para el resto sigue requiriendo confirmacion
  // manual (anti-fraude de justificante falso, audit 25-jun).
  autoConfirmPayment Boolean @default(false)
  // Cliente de credito (decision de Juan, 2-sep-2026): empresas que aprueban, se
  // trabaja, se ENTREGA y pagan despues. El permiso vive en el CLIENTE, no en el
  // pedido -- "se puede entregar y trabajar con determinados clientes". Sin tope
  // de importe: el carril es para trabajos propios de Juan, asi que no hay coste
  // de traductor externo que adelantar. Lo activa ADMIN/PM en la ficha.
  creditEnabled Boolean @default(false)
  creditDays    Int     @default(30)
  // Intermediario que trajo a este cliente (p.ej. Ahmed). Autorrelación nullable:
  // "es intermediario" se infiere si tiene `referrals`. onDelete SetNull = borrar al
  // intermediario no borra a sus clientes, solo los deja sueltos.
  intermediaryId String?
  intermediary   Customer?  @relation("CustomerIntermediary", fields: [intermediaryId], references: [id], onDelete: SetNull)
  referrals      Customer[] @relation("CustomerIntermediary")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes Quote[]

  @@index([email])
  @@index([intermediaryId])
}

model Quote {
  id             String            @id @default(uuid())
  quoteNumber    String            @unique
  status         QuoteStatus       @default(DRAFT)
  customerId     String
  customerName   String
  customerEmail  String
  customerPhone  String?
  sourceLang     String
  targetLang     String
  deliveryType   QuoteDeliveryType @default(DIGITAL_PDF)
  deliveryTerm   String?           // plazo de entrega ("2-3 días hábiles"): bloque Entrega, no notas legales
  shippingBase   Decimal           @default(0) @db.Decimal(12, 2)
  vatRate        Decimal           @default(0.21) @db.Decimal(5, 4)
  currency       String            @default("EUR")
  discountType   QuoteDiscountType @default(NONE)
  discountValue  Decimal           @default(0) @db.Decimal(12, 2)
  notesLegal     String?
  holderNames    String? // titulares de los certificados (p.ej. clientes de Auream) — solo informativo
  validityDays   Int               @default(15)
  issuedAt       DateTime          @default(now())
  validUntil     DateTime
  sentAt         DateTime?
  openedAt       DateTime?
  paidAt         DateTime?
  deliveredAt    DateTime?
  publicToken    String            @unique
  tokenExpiresAt DateTime?
  pdfUrl         String?
  pdfHash        String?
  subtotal       Decimal           @default(0) @db.Decimal(12, 2)
  discountAmount Decimal           @default(0) @db.Decimal(12, 2)
  shippingAmount Decimal           @default(0) @db.Decimal(12, 2)
  vatAmount      Decimal           @default(0) @db.Decimal(12, 2)
  total          Decimal           @default(0) @db.Decimal(12, 2)
  adminCreatedBy String?
  adminSentBy    String?
  expedienteRef  String?           // ref del expediente entrante (exp:REF) que originó el presupuesto
  marginPct      Int?              // margen % aplicado sobre el coste del traductor (solo interno)
  // Identidad del jurado que realizará la traducción (directriz Juan 12-ago:
  // "da seriedad") — sale en email/WhatsApp/PDF de la cotización si está.
  // Autorrellenados desde la solicitud lavori del expediente; editables.
  translatorName String?
  translatorMaec String?           // nº MAEC / T-IJ, tal cual se muestra
  paymentMethods String[]          // métodos de pago a mostrar en el PDF: bbva/openbank/bizum/paypal
  contactWhatsapp String?          // WhatsApp/teléfono a mostrar en este presupuesto (override)
  pdfLang         String?          // idioma del PDF del presupuesto (es|en|fr|it|pt|de); null = es. Petición Juan 21-ago
  // Tarifario aprendido (27-ago-2026): presupuesto emitido solo por el agente de
  // precios con tarifa aprobada; el jurado que la dio recibe el encargo al pagar
  // con su cifra ya cerrada (paraTi = suma de supplierUnitCost de las líneas).
  autoPricedBy        String?
  lavoriMiembroId     String?
  lavoriMiembroNombre String?
  // Presupuesto perdido: motivo dado por el cliente (1 clic desde el email de
  // expirado, confirmado con POST en /q/[token]) + post-mortem determinista
  // calculado al expirar (cron reminders); el digest los lee, no los recalcula.
  lostReason     QuoteLostReason?
  lostReasonNote String?
  lostFeedbackAt DateTime?
  postMortemJson Json?
  // Instante real del marcado EXPIRED (cron reminders o flip de la página pública).
  // validUntil NO sirve como ventana del digest: el cron corre horas después.
  expiredAt      DateTime?
  deletedAt      DateTime?         // papelera: presupuesto no formalizado movido a "Eliminados"
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orders       Order[]
  lines        QuoteLine[]
  payments     QuotePayment[]
  messageLogs  MessageLog[]
  accessEvents AccessEvent[]
  stripeEvents StripeEventLog[]

  @@index([customerEmail])
  @@index([status, sentAt])
  @@index([validUntil])
  @@index([deletedAt])
}

model QuoteLine {
  id          String   @id @default(uuid())
  quoteId     String
  description String
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  supplierUnitCost Decimal? @db.Decimal(12, 2) // coste traductor (sin IVA) — solo interno
  lineTotal   Decimal  @db.Decimal(12, 2)
  sourceFileUrl String? // PDF origen (Blob) de este documento, para ver/descargar
  pageStart   Int?      // rango de páginas del documento dentro del PDF origen
  pageEnd     Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model QuotePayment {
  id                    String               @id @default(uuid())
  quoteId               String
  provider              QuotePaymentProvider
  amount                Decimal              @db.Decimal(12, 2)
  currency              String               @default("EUR")
  stripeSessionId       String?
  stripePaymentIntentId String?
  createdAt             DateTime             @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, createdAt])
  @@index([stripeSessionId])
  @@index([stripePaymentIntentId])
}

model MessageLog {
  id         String              @id @default(uuid())
  quoteId    String
  channel    QuoteMessageChannel
  type       QuoteMessageType
  recipient  String
  subject    String?
  body       String
  sentAt     DateTime?
  providerId String?
  status     String              @default("PENDING")
  createdAt  DateTime            @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, createdAt])
  @@index([channel, type])
}

model AccessEvent {
  id        String               @id @default(uuid())
  quoteId   String
  type      QuoteAccessEventType @default(OPENED)
  at        DateTime             @default(now())
  userAgent String?
  ipHash    String?

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, at])
}

model StripeEventLog {
  id         String   @id @default(uuid())
  eventId    String   @unique
  eventType  String
  quoteId    String?
  payload    Json?
  processedAt DateTime @default(now())

  quote Quote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@index([quoteId, processedAt])
}

model FunnelEvent {
  id        String   @id @default(cuid())
  sessionId String
  reference String
  step      String
  createdAt DateTime @default(now())
  metadata  Json?

  @@unique([sessionId, step])
  @@index([step, createdAt])
}

model OrderSession {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  step          SessionStep @default(UPLOAD)
  purpose       String?
  authState     AuthState   @default(GUEST)
  userId        String?
  clientEmail   String?
  clientPhone   String?
  clientLocale  String?     @default("es") // idioma del cliente (es|fr) capturado en la puerta
  subtotalCents Int         @default(0)
  vatCents      Int         @default(0)
  totalCents    Int         @default(0)
  currency      String      @default("EUR")
  isPaid        Boolean     @default(false)
  paidAt        DateTime?
  paymentMethod String?
  reference     String      @unique
  deliveryType  String?     @default("pdf") // "pdf" | "paper"
  shippingJson  Json?       // dirección de envío en papel (nombre, dirección, ciudad, provincia, CP)

  docs OrderDocument[]

  @@index([userId])
  @@index([step, updatedAt])
}

model OrderDocument {
  id           String       @id @default(cuid())
  sessionId    String
  session      OrderSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  fileKey      String
  fileUrl      String
  filename     String
  mimeType     String
  sizeBytes    Int
  detectedType String?
  sourceLang   String?
  targetLang   String?      @default("es")
  quotedCents  Int?
  createdAt    DateTime     @default(now())

  @@index([sessionId, createdAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}

model ChatSession {
  id                 String   @id @default(cuid())
  sessionId          String   @unique
  messages           Json
  detectedLanguage   String?
  detectedIntent     String?
  referredToWhatsApp Boolean  @default(false)
  userEmail          String?
  ipHash             String?
  messageCount       Int      @default(0)
  toolCalls          Json     @default("[]")
  hasAttachment      Boolean  @default(false)
  lastError          Json?
  errorCount         Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────
// SISTEMA IA — Análisis de documentos y presupuesto instantáneo
// ─────────────────────────────────────────────────────────────────

model DocumentAnalysis {
  id               String                 @id @default(cuid())

  // Archivo
  fileName         String
  fileUrl          String
  fileSize         Int
  mimeType         String
  pageCount        Int                    @default(1)

  // Análisis IA (respuesta completa de Claude)
  analysisJson     Json?
  documentType     String?                // birth_certificate, marriage_certificate, etc.
  documentCategory String?                // civil_registry, identity, academic, legal, etc.
  sourceLanguage   String?                // ISO 639-1
  targetLanguage   String?                @default("es")
  countryOrigin    String?                // ISO 3166-1 alpha-2
  estimatedWords   Int?
  complexity       String?                // standard, complex, highly_complex
  confidence       Float?                 // 0-1

  // Datos extraídos (censurados para RGPD)
  extractedNames   String[]
  extractedDates   String[]

  // Presupuesto generado
  quoteAmount      Float?
  quoteUrgent      Float?
  estimatedDays    String?
  estimatedDaysUrgent String?
  quoteBreakdown   Json?

  // Estado
  status           DocAnalysisStatus      @default(UPLOADED)

  // Origen de captación (preset ?p=… de la puerta: uge-ce, regularizacion-2026)
  source           String?

  // Cliente (anónimo hasta que paga)
  sessionToken     String?
  clientEmail      String?
  clientName       String?
  clientPhone      String?
  ipHash           String?
  gdprConsent      Boolean                @default(false)
  gdprConsentAt    DateTime?
  // Consentimiento SEPARADO y no premarcado para el envío del presupuesto por
  // email y su recordatorio. El gdprConsent de arriba solo cubre el tratamiento
  // de los DOCUMENTOS para generar el presupuesto: no ampara enviar correo.
  // La LSSI (art. 21.1) exige autorización expresa y previa para el email
  // comercial, y su excepción (21.2) pide relación contractual previa — un lead
  // que nunca compró no la tiene. El cron de recordatorios filtra por este campo.
  marketingConsent   Boolean              @default(false)
  marketingConsentAt DateTime?

  // Relación con Order (se crea al pagar)
  orderId          String?
  order            Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)
  // Referencia de la OrderSession de la puerta (== Order.reference). Soft-link
  // estampado en /api/puerta/checkout; createOrderFromSession lo usa para fijar
  // orderId cuando el Order nace en el webhook de pago.
  orderReference   String?

  reminderSentAt   DateTime?

  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([sessionToken])
  @@index([status, createdAt])
  @@index([clientEmail])
  @@index([orderReference])
}

model FailedEmail {
  id        String   @id @default(cuid())
  error     String
  attempt   Int
  createdAt DateTime @default(now())
}

// Trimestre de IVA cerrado (303 presentado). period = "YYYY-TN".
// Las emisiones en lote no retro-fechan facturas dentro de un periodo cerrado.
model TaxPeriodClose {
  period   String   @id
  closedAt DateTime @default(now())
  closedBy String
}

// Solicitud de PRECIO a lavori para un LEAD (WhatsApp/teléfono) sin pedido aún:
// ancla de la ida (idempotencia por ref) y de la vuelta (precio_propuesto).
model LavoriPriceRequest {
  id            String   @id @default(cuid())
  ref           String   @unique // motorRef del sobre sin el sufijo -precio (LEAD-xxxxxxxxxx)
  par           String
  candidatos    String[]
  expedienteRef String?
  customerHint  String? // nombre/teléfono del lead SOLO para staff; jamás viaja a lavori
  docsCount     Int      @default(0)
  words         Int?
  encargoId     String?
  status        String   @default("SENT") // SENT | PRICED | ACCEPTED
  priceCents    Int?
  plazoDias     Int?
  notas         String?
  miembroId     String?
  miembroNombre String?
  // Vínculo presupuesto↔solicitud (Fase 2, contrato 12-ago-2026): al pagarse el
  // presupuesto, el emisor precio_aceptado localiza la solicitud por aquí (con
  // fallback por expedienteRef) y comunica al encargo existente en lavori.
  quoteId       String?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([quoteId])
  @@index([expedienteRef])
}

enum CollaboratorSupplierType {
  AUTONOMO
  EMPRESA
}

enum AssignmentStatus {
  REQUESTED
  QUOTED
  QUOTE_REVISION_REQUESTED
  ACCEPTED
  REJECTED
  DELIVERED
}

model Collaborator {
  id           String                   @id @default(cuid())
  fullName     String
  email        String                   @unique
  phone        String?
  languages    String[]
  swornNumber  String?
  nif          String?
  address      String?
  companyName  String?
  supplierType CollaboratorSupplierType @default(AUTONOMO)
  active       Boolean                  @default(true)
  notes        String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  assignments  CollaboratorAssignment[]
  expenses     Expense[]

  @@index([active])
}

model CollaboratorAssignment {
  id                String           @id @default(cuid())
  orderId           String
  collaboratorId    String
  status            AssignmentStatus @default(REQUESTED)
  isWinning         Boolean          @default(false)
  accessToken       String           @unique @default(uuid())
  adminNotes        String?
  quotedPriceCents  Int?
  quotedDeadline    DateTime?
  quotedAt          DateTime?
  collaboratorNotes String?
  acceptedAt        DateTime?
  rejectedAt        DateTime?
  rejectionReason   String?
  revisionReason    String?
  deliveredFileUrl  String?
  deliveredFileKey  String?
  deliveredFilename String?
  deliveredMimeType String?
  deliveredAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  order             Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  collaborator      Collaborator     @relation(fields: [collaboratorId], references: [id], onDelete: Restrict)

  @@unique([orderId, collaboratorId])
  @@index([accessToken])
  @@index([orderId, status])
}

enum DocAnalysisStatus {
  UPLOADED
  ANALYZING
  ANALYZED
  ANALYSIS_FAILED
  QUOTE_GENERATED
  PAYMENT_PENDING
  PAID
  IN_TRANSLATION
  TRANSLATED
  DELIVERED
}

enum InboundEmailStatus {
  NEW
  DRAFTED
  REPLIED
  ARCHIVED
}

// Bandeja de entrada del buzón (Microsoft Graph, Mail.Read): emails de clientes
// sincronizados a la app para responder desde /admin/inbox con borrador IA.
// Sin FKs a Customer/Quote/Order a propósito: el match es best-effort por email
// y no debe impedir borrar/mover esas entidades.
enum InboundChannel {
  EMAIL
  WHATSAPP
}

model InboundEmail {
  id                String             @id @default(uuid())
  graphId           String             @unique // id externo del mensaje (Graph id o Twilio MessageSid)
  channel           InboundChannel     @default(EMAIL)
  fromPhone         String? // E.164 (WhatsApp)
  mediaJson         Json? // WhatsApp: [{url, contentType, name, size}] ya en nuestro Blob
  internetMessageId String?
  conversationId    String?
  fromEmail         String
  fromName          String?
  subject           String
  bodyPreview       String
  bodyText          String? // cuerpo en texto plano (para el LLM y la vista)
  receivedAt        DateTime
  status            InboundEmailStatus @default(NEW)
  customerId        String? // match por email en Customer
  quoteId           String? // último Quote del cliente al sincronizar
  orderReference    String? // último Order del cliente al sincronizar
  draftSubject      String? // último borrador IA (editable en UI)
  draftBody         String?
  draftedAt         DateTime?
  replySubject      String? // respuesta realmente enviada
  replyBody         String?
  repliedAt         DateTime?
  repliedBy         String?
  briefJson         Json? // lectura IA del email (par, urgencia, provisional, notas, preguntas)
  briefAt           DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status, receivedAt])
  @@index([fromEmail])
  @@index([fromPhone])
}

// ── Tarifario aprendido (agente de precios, 27-ago-2026) ─────────────────────
// Memoria de lo que ya ha pasado por tipo de documento y par: coste del jurado
// (precio_propuesto de lavori) y precio neto que pagó el cliente. Con una tarifa
// APPROVED, la puerta presupuesta sola y no vuelve a preguntar al traductor.
model LearnedRate {
  id            String   @id @default(cuid())
  lang          String   // lengua no española del par (en, de, pt, he…); nunca fr
  direction     String   // "to_es" | "from_es"
  docType       String   // documentType de DocumentAnalysis normalizado; "any" = comodín por palabra
  apostille     Boolean  @default(false)
  unit          String   // "doc" (por documento) | "kword" (por 1000 palabras)
  costCents     Int      // coste del jurado por unidad, sin IVA
  clientCents   Int?     // precio neto al cliente por unidad (último pagado / enviado)
  wordsRef      Int?     // tamaño medio (palabras/doc) de las muestras; tolerancia ±30 % para unit=doc
  plazoDias     Int?
  miembroId     String?
  miembroNombre String?
  status        String   @default("CANDIDATE") // CANDIDATE | APPROVED | VETOED
  samples       Int      @default(0)
  lastSampleAt  DateTime?
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sampleRows    LearnedRateSample[]

  @@unique([lang, direction, docType, apostille])
  @@index([status])
}

model LearnedRateSample {
  id          String   @id @default(cuid())
  rateId      String
  kind        String   // translator_price | client_paid | seed | manual | auto_quote
  costCents   Int?
  clientCents Int?
  words       Int?
  pages       Int?
  quoteId     String?
  leadRef     String?
  orderRef    String?
  miembroId   String?
  note        String?
  createdAt   DateTime @default(now())
  rate LearnedRate @relation(fields: [rateId], references: [id], onDelete: Cascade)

  @@index([rateId, createdAt])
}
