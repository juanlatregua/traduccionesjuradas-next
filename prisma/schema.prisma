generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  IN_PROGRESS
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  REDSYS
  PAYPAL
  BIZUM
  TRANSFER
  STRIPE
}

enum DeliveryState {
  PRESUPUESTO
  EN_PROCESO
  TRADUCIDO
}

enum QuoteStatus {
  DRAFT
  SENT
  OPENED
  ACCEPTED
  PAID
  IN_PROGRESS
  DELIVERED
  EXPIRED
}

enum QuoteDeliveryType {
  DIGITAL_PDF
  PAPER_SHIP
}

enum QuoteDiscountType {
  NONE
  PERCENT
  FIXED
}

enum QuotePaymentProvider {
  STRIPE
  PAYPAL
  BIZUM
  TRANSFER
  OTHER
}

enum QuoteMessageChannel {
  EMAIL
  WHATSAPP
}

enum QuoteMessageType {
  PAY_LINK
  REMINDER
  PAID_CONFIRMATION
  DRAFT_WHATSAPP
  EXPIRED_NOTICE
  RESEND_PAY_LINK
}

enum QuoteAccessEventType {
  OPENED
}

enum SessionStep {
  START
  UPLOAD
  REVIEW
  CHECKOUT
  CONFIRMATION
}

enum AuthState {
  GUEST
  AUTHENTICATED
}

model Order {
  id                 String         @id @default(cuid())
  reference          String         @unique
  idempotencyKey     String?        @unique
  clientEmail        String
  clientName         String?
  clientPhone        String?
  clientNotes        String?
  source             String
  title              String
  langPair           String?
  words              Int?
  pagesLabel         String?
  amountCents        Int
  currency           String         @default("eur")
  status             OrderStatus    @default(PENDING_PAYMENT)
  paymentStatus      PaymentStatus  @default(PENDING)
  paymentMethod      PaymentMethod?
  externalPaymentId  String?
  deliveryState      DeliveryState  @default(PRESUPUESTO)
  deliveryType       String         @default("pdf")
  translatedFileUrl  String?
  quotePreviewFileKey String?
  quotePreviewFileUrl String?
  quoteSnapshotJson   Json?
  paymentProofFileKey String?
  finalDeliveryFileKey String?
  finalDeliveryFileUrl String?
  finalFilename       String?
  finalMimeType       String?
  assignedTo         String?
  dueDate            DateTime?
  quoteId            String?
  draftFileKey       String?
  draftFileUrl       String?
  draftGeneratedAt   DateTime?
  draftFilename      String?
  draftContentJson   String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  paidAt             DateTime?

  quote    Quote?         @relation(fields: [quoteId], references: [id])
  events   OrderEvent[]
  paymentEvents OrderPaymentEvent[]
  billing  BillingData?
  shipping ShippingData?
  documentAnalyses DocumentAnalysis[]
  collaboratorAssignments CollaboratorAssignment[]

  @@index([clientEmail])
  @@index([createdAt])
  @@index([paymentStatus, status])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  type      String
  message   String
  payload   Json?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model OrderPaymentEvent {
  id              String        @id @default(cuid())
  orderId          String
  provider         PaymentMethod
  providerEventId  String
  idempotencyKey   String        @unique
  source           String
  payload          Json?
  createdAt        DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([provider, providerEventId])
}

model BillingData {
  id         String    @id @default(cuid())
  orderId    String    @unique
  fiscalName String
  nif        String
  address    String
  city       String
  postalCode String
  country    String    @default("España")
  email      String
  requested  Boolean   @default(false)
  notifiedAt DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model ShippingData {
  id         String @id @default(cuid())
  orderId    String @unique
  name       String
  phone      String
  address    String
  city       String
  province   String
  postalCode String
  country    String @default("España")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes Quote[]

  @@index([email])
}

model Quote {
  id             String            @id @default(uuid())
  quoteNumber    String            @unique
  status         QuoteStatus       @default(DRAFT)
  customerId     String
  customerName   String
  customerEmail  String
  customerPhone  String?
  sourceLang     String
  targetLang     String
  deliveryType   QuoteDeliveryType @default(DIGITAL_PDF)
  shippingBase   Decimal           @default(0) @db.Decimal(12, 2)
  vatRate        Decimal           @default(0.21) @db.Decimal(5, 4)
  currency       String            @default("EUR")
  discountType   QuoteDiscountType @default(NONE)
  discountValue  Decimal           @default(0) @db.Decimal(12, 2)
  notesLegal     String?
  validityDays   Int               @default(15)
  issuedAt       DateTime          @default(now())
  validUntil     DateTime
  sentAt         DateTime?
  openedAt       DateTime?
  paidAt         DateTime?
  deliveredAt    DateTime?
  publicToken    String            @unique
  tokenExpiresAt DateTime?
  pdfUrl         String?
  pdfHash        String?
  subtotal       Decimal           @default(0) @db.Decimal(12, 2)
  discountAmount Decimal           @default(0) @db.Decimal(12, 2)
  shippingAmount Decimal           @default(0) @db.Decimal(12, 2)
  vatAmount      Decimal           @default(0) @db.Decimal(12, 2)
  total          Decimal           @default(0) @db.Decimal(12, 2)
  adminCreatedBy String?
  adminSentBy    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orders       Order[]
  lines        QuoteLine[]
  payments     QuotePayment[]
  messageLogs  MessageLog[]
  accessEvents AccessEvent[]
  stripeEvents StripeEventLog[]

  @@index([customerEmail])
  @@index([status, sentAt])
  @@index([validUntil])
}

model QuoteLine {
  id          String   @id @default(uuid())
  quoteId     String
  description String
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  lineTotal   Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model QuotePayment {
  id                    String               @id @default(uuid())
  quoteId               String
  provider              QuotePaymentProvider
  amount                Decimal              @db.Decimal(12, 2)
  currency              String               @default("EUR")
  stripeSessionId       String?
  stripePaymentIntentId String?
  createdAt             DateTime             @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, createdAt])
  @@index([stripeSessionId])
  @@index([stripePaymentIntentId])
}

model MessageLog {
  id         String              @id @default(uuid())
  quoteId    String
  channel    QuoteMessageChannel
  type       QuoteMessageType
  recipient  String
  subject    String?
  body       String
  sentAt     DateTime?
  providerId String?
  status     String              @default("PENDING")
  createdAt  DateTime            @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, createdAt])
  @@index([channel, type])
}

model AccessEvent {
  id        String               @id @default(uuid())
  quoteId   String
  type      QuoteAccessEventType @default(OPENED)
  at        DateTime             @default(now())
  userAgent String?
  ipHash    String?

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, at])
}

model StripeEventLog {
  id         String   @id @default(uuid())
  eventId    String   @unique
  eventType  String
  quoteId    String?
  payload    Json?
  processedAt DateTime @default(now())

  quote Quote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@index([quoteId, processedAt])
}

model FunnelEvent {
  id        String   @id @default(cuid())
  sessionId String
  reference String
  step      String
  createdAt DateTime @default(now())
  metadata  Json?

  @@unique([sessionId, step])
  @@index([step, createdAt])
}

model OrderSession {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  step          SessionStep @default(UPLOAD)
  purpose       String?
  authState     AuthState   @default(GUEST)
  userId        String?
  clientEmail   String?
  clientPhone   String?
  subtotalCents Int         @default(0)
  vatCents      Int         @default(0)
  totalCents    Int         @default(0)
  currency      String      @default("EUR")
  isPaid        Boolean     @default(false)
  paidAt        DateTime?
  paymentMethod String?
  reference     String      @unique

  docs OrderDocument[]

  @@index([userId])
  @@index([step, updatedAt])
}

model OrderDocument {
  id           String       @id @default(cuid())
  sessionId    String
  session      OrderSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  fileKey      String
  fileUrl      String
  filename     String
  mimeType     String
  sizeBytes    Int
  detectedType String?
  sourceLang   String?
  targetLang   String?      @default("es")
  quotedCents  Int?
  createdAt    DateTime     @default(now())

  @@index([sessionId, createdAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}

model ChatSession {
  id                 String   @id @default(cuid())
  sessionId          String   @unique
  messages           Json
  detectedLanguage   String?
  detectedIntent     String?
  referredToWhatsApp Boolean  @default(false)
  userEmail          String?
  ipHash             String?
  messageCount       Int      @default(0)
  toolCalls          Json     @default("[]")
  hasAttachment      Boolean  @default(false)
  lastError          Json?
  errorCount         Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────
// SISTEMA IA — Análisis de documentos y presupuesto instantáneo
// ─────────────────────────────────────────────────────────────────

model DocumentAnalysis {
  id               String                 @id @default(cuid())

  // Archivo
  fileName         String
  fileUrl          String
  fileSize         Int
  mimeType         String
  pageCount        Int                    @default(1)

  // Análisis IA (respuesta completa de Claude)
  analysisJson     Json?
  documentType     String?                // birth_certificate, marriage_certificate, etc.
  documentCategory String?                // civil_registry, identity, academic, legal, etc.
  sourceLanguage   String?                // ISO 639-1
  targetLanguage   String?                @default("es")
  countryOrigin    String?                // ISO 3166-1 alpha-2
  estimatedWords   Int?
  complexity       String?                // standard, complex, highly_complex
  confidence       Float?                 // 0-1

  // Datos extraídos (censurados para RGPD)
  extractedNames   String[]
  extractedDates   String[]

  // Presupuesto generado
  quoteAmount      Float?
  quoteUrgent      Float?
  estimatedDays    String?
  estimatedDaysUrgent String?
  quoteBreakdown   Json?

  // Estado
  status           DocAnalysisStatus      @default(UPLOADED)

  // Origen de captación (preset ?p=… de la puerta: uge-ce, regularizacion-2026)
  source           String?

  // Cliente (anónimo hasta que paga)
  sessionToken     String?
  clientEmail      String?
  clientName       String?
  clientPhone      String?
  ipHash           String?
  gdprConsent      Boolean                @default(false)
  gdprConsentAt    DateTime?

  // Relación con Order (se crea al pagar)
  orderId          String?
  order            Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)

  reminderSentAt   DateTime?

  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([sessionToken])
  @@index([status, createdAt])
  @@index([clientEmail])
}

model FailedEmail {
  id        String   @id @default(cuid())
  error     String
  attempt   Int
  createdAt DateTime @default(now())
}

enum CollaboratorSupplierType {
  AUTONOMO
  EMPRESA
}

enum AssignmentStatus {
  REQUESTED
  QUOTED
  QUOTE_REVISION_REQUESTED
  ACCEPTED
  REJECTED
  DELIVERED
}

model Collaborator {
  id           String                   @id @default(cuid())
  fullName     String
  email        String                   @unique
  phone        String?
  languages    String[]
  swornNumber  String?
  nif          String?
  address      String?
  companyName  String?
  supplierType CollaboratorSupplierType @default(AUTONOMO)
  active       Boolean                  @default(true)
  notes        String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  assignments  CollaboratorAssignment[]

  @@index([active])
}

model CollaboratorAssignment {
  id                String           @id @default(cuid())
  orderId           String
  collaboratorId    String
  status            AssignmentStatus @default(REQUESTED)
  accessToken       String           @unique @default(uuid())
  adminNotes        String?
  quotedPriceCents  Int?
  quotedDeadline    DateTime?
  quotedAt          DateTime?
  collaboratorNotes String?
  acceptedAt        DateTime?
  rejectedAt        DateTime?
  rejectionReason   String?
  revisionReason    String?
  deliveredFileUrl  String?
  deliveredFileKey  String?
  deliveredFilename String?
  deliveredMimeType String?
  deliveredAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  order             Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  collaborator      Collaborator     @relation(fields: [collaboratorId], references: [id], onDelete: Restrict)

  @@unique([orderId, collaboratorId])
  @@index([accessToken])
  @@index([orderId, status])
}

enum DocAnalysisStatus {
  UPLOADED
  ANALYZING
  ANALYZED
  ANALYSIS_FAILED
  QUOTE_GENERATED
  PAYMENT_PENDING
  PAID
  IN_TRANSLATION
  TRANSLATED
  DELIVERED
}
