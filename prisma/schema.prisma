generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  IN_PROGRESS
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  REDSYS
  PAYPAL
  BIZUM
  TRANSFER
  STRIPE
}

enum DeliveryState {
  PRESUPUESTO
  EN_PROCESO
  TRADUCIDO
}

enum QuoteStatus {
  DRAFT
  SENT
  OPENED
  ACCEPTED
  PAID
  IN_PROGRESS
  DELIVERED
  EXPIRED
}

enum QuoteDeliveryType {
  DIGITAL_PDF
  PAPER_SHIP
}

enum QuoteDiscountType {
  NONE
  PERCENT
  FIXED
}

enum QuotePaymentProvider {
  STRIPE
  PAYPAL
  BIZUM
  TRANSFER
  OTHER
}

enum QuoteMessageChannel {
  EMAIL
  WHATSAPP
}

enum QuoteMessageType {
  PAY_LINK
  REMINDER
  PAID_CONFIRMATION
  DRAFT_WHATSAPP
  EXPIRED_NOTICE
  RESEND_PAY_LINK
}

enum QuoteAccessEventType {
  OPENED
}

enum SessionStep {
  START
  UPLOAD
  REVIEW
  CHECKOUT
  CONFIRMATION
}

enum AuthState {
  GUEST
  AUTHENTICATED
}

model Order {
  id                 String         @id @default(cuid())
  reference          String         @unique
  idempotencyKey     String?        @unique
  clientEmail        String
  clientName         String?
  source             String
  title              String
  langPair           String?
  words              Int?
  pagesLabel         String?
  amountCents        Int
  currency           String         @default("eur")
  status             OrderStatus    @default(PENDING_PAYMENT)
  paymentStatus      PaymentStatus  @default(PENDING)
  paymentMethod      PaymentMethod?
  externalPaymentId  String?
  deliveryState      DeliveryState  @default(PRESUPUESTO)
  deliveryType       String         @default("pdf")
  translatedFileUrl  String?
  quotePreviewFileKey String?
  quotePreviewFileUrl String?
  quoteSnapshotJson   Json?
  paymentProofFileKey String?
  finalDeliveryFileKey String?
  finalDeliveryFileUrl String?
  finalFilename       String?
  finalMimeType       String?
  assignedTo         String?
  dueDate            DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  paidAt             DateTime?

  events   OrderEvent[]
  billing  BillingData?
  shipping ShippingData?

  @@index([clientEmail])
  @@index([createdAt])
  @@index([paymentStatus, status])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  type      String
  message   String
  payload   Json?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model BillingData {
  id         String    @id @default(cuid())
  orderId    String    @unique
  fiscalName String
  nif        String
  address    String
  city       String
  postalCode String
  country    String    @default("España")
  email      String
  requested  Boolean   @default(false)
  notifiedAt DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model ShippingData {
  id         String @id @default(cuid())
  orderId    String @unique
  name       String
  phone      String
  address    String
  city       String
  province   String
  postalCode String
  country    String @default("España")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes Quote[]

  @@index([email])
}

model Quote {
  id             String            @id @default(uuid())
  quoteNumber    String            @unique
  status         QuoteStatus       @default(DRAFT)
  customerId     String
  customerName   String
  customerEmail  String
  customerPhone  String?
  sourceLang     String
  targetLang     String
  deliveryType   QuoteDeliveryType @default(DIGITAL_PDF)
  shippingBase   Decimal           @default(0) @db.Decimal(12, 2)
  vatRate        Decimal           @default(0.21) @db.Decimal(5, 4)
  currency       String            @default("EUR")
  discountType   QuoteDiscountType @default(NONE)
  discountValue  Decimal           @default(0) @db.Decimal(12, 2)
  notesLegal     String?
  validityDays   Int               @default(15)
  issuedAt       DateTime          @default(now())
  validUntil     DateTime
  sentAt         DateTime?
  openedAt       DateTime?
  paidAt         DateTime?
  deliveredAt    DateTime?
  publicToken    String            @unique
  tokenExpiresAt DateTime?
  pdfUrl         String?
  pdfHash        String?
  subtotal       Decimal           @default(0) @db.Decimal(12, 2)
  discountAmount Decimal           @default(0) @db.Decimal(12, 2)
  shippingAmount Decimal           @default(0) @db.Decimal(12, 2)
  vatAmount      Decimal           @default(0) @db.Decimal(12, 2)
  total          Decimal           @default(0) @db.Decimal(12, 2)
  adminCreatedBy String?
  adminSentBy    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines        QuoteLine[]
  payments     QuotePayment[]
  messageLogs  MessageLog[]
  accessEvents AccessEvent[]
  stripeEvents StripeEventLog[]

  @@index([customerEmail])
  @@index([status, sentAt])
  @@index([validUntil])
}

model QuoteLine {
  id          String   @id @default(uuid())
  quoteId     String
  description String
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  lineTotal   Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model QuotePayment {
  id                    String               @id @default(uuid())
  quoteId               String
  provider              QuotePaymentProvider
  amount                Decimal              @db.Decimal(12, 2)
  currency              String               @default("EUR")
  stripeSessionId       String?
  stripePaymentIntentId String?
  createdAt             DateTime             @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, createdAt])
  @@index([stripeSessionId])
  @@index([stripePaymentIntentId])
}

model MessageLog {
  id         String              @id @default(uuid())
  quoteId    String
  channel    QuoteMessageChannel
  type       QuoteMessageType
  recipient  String
  subject    String?
  body       String
  sentAt     DateTime?
  providerId String?
  status     String              @default("PENDING")
  createdAt  DateTime            @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, createdAt])
  @@index([channel, type])
}

model AccessEvent {
  id        String               @id @default(uuid())
  quoteId   String
  type      QuoteAccessEventType @default(OPENED)
  at        DateTime             @default(now())
  userAgent String?
  ipHash    String?

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, at])
}

model StripeEventLog {
  id         String   @id @default(uuid())
  eventId    String   @unique
  eventType  String
  quoteId    String?
  payload    Json?
  processedAt DateTime @default(now())

  quote Quote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@index([quoteId, processedAt])
}

model OrderSession {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  step          SessionStep @default(UPLOAD)
  purpose       String?
  authState     AuthState   @default(GUEST)
  userId        String?
  subtotalCents Int         @default(0)
  vatCents      Int         @default(0)
  totalCents    Int         @default(0)
  currency      String      @default("EUR")
  isPaid        Boolean     @default(false)
  paidAt        DateTime?
  paymentMethod String?
  reference     String      @unique

  docs OrderDocument[]

  @@index([userId])
  @@index([step, updatedAt])
}

model OrderDocument {
  id           String       @id @default(cuid())
  sessionId    String
  session      OrderSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  fileKey      String
  fileUrl      String
  filename     String
  mimeType     String
  sizeBytes    Int
  detectedType String?
  sourceLang   String?
  targetLang   String?      @default("es")
  createdAt    DateTime     @default(now())

  @@index([sessionId, createdAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}
