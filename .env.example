# ──────────────────────────────────────────────
# .env.example — Variables de entorno necesarias
# Copia este archivo a .env.local y rellena los valores
# ──────────────────────────────────────────────

# ── Base de datos (Prisma) ──
DATABASE_URL="postgres://user:pass@host:5432/db?sslmode=require"

# ── Auth (NextAuth + Google OAuth) ──
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=          # openssl rand -base64 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STAFF_EMAILS=admin@example.com   # emails con acceso staff, separados por coma

# ── Email (Microsoft Graph API) ──
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
EMAIL_FROM=juansilvamoreno@holabonjour.es
PRESUPUESTO_TO=hola@traduccionesjuradas.net
# PM_NOTIFICATION_TO=       # (opcional) destinatario notificaciones PM
# EMAIL_SKIP_DEV=true       # (opcional) no enviar emails en desarrollo

# ── SMS / WhatsApp (Twilio) ──
SMS_PROVIDER=log            # "log" en dev, "twilio" en producción
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_API_KEY_SID=       # (alternativa a AUTH_TOKEN)
# TWILIO_API_KEY_SECRET=
# TWILIO_FROM_NUMBER=+34...
# TWILIO_WHATSAPP_FROM=whatsapp:+34...

# ── Pagos: Stripe ──
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_QUOTES_WEBHOOK_SECRET=

# ── Pagos: Redsys ──
# REDSYS_SECRET_KEY=
# REDSYS_MERCHANT_CODE=
# REDSYS_TERMINAL=1
# REDSYS_ENV=test           # "test" o "production"

# ── Pagos: PayPal ──
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=sandbox        # "sandbox" o "production"

# ── Pagos: config general ──
NEXT_PUBLIC_ENABLE_REDSYS=false
NEXT_PUBLIC_ENABLE_PAYPAL=false
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# NEXT_PUBLIC_PAYPAL_MANUAL_LINK=
# NEXT_PUBLIC_PAYPAL_ACCOUNT=

# ── Transferencia / Bizum (datos públicos mostrados al cliente) ──
# NEXT_PUBLIC_TRANSFER_ACCOUNT_HOLDER=
# NEXT_PUBLIC_TRANSFER_IBAN=
# NEXT_PUBLIC_TRANSFER_BIC=
# NEXT_PUBLIC_BIZUM_IDENTIFIER=

# ── AI / OCR ──
ANTHROPIC_API_KEY=          # Claude (análisis de documentos + chat)
OCR_SPACE_API_KEY=          # OCR.space (fallback)
# GOOGLE_VISION_API_KEY=    # (alternativa a service account)
# GOOGLE_VISION_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# ── Almacenamiento (Vercel Blob) ──
# BLOB_READ_WRITE_TOKEN=    # proporcionado por Vercel automáticamente

# ── Seguridad ──
ORDER_TOKEN_SECRET=         # openssl rand -hex 32 — firma HMAC para URLs de pedidos
# CRON_SECRET=              # Bearer token para cron jobs de Vercel
# QUOTES_CRON_SECRET=       # Bearer token para cron de recordatorios de presupuestos
# RATE_LIMIT_STORE=memory   # "memory" (default) o "redis"

# ── Operacional ──
# NEXT_PUBLIC_SITE_URL=https://www.traduccionesjuradas.net
# ETA_HOLIDAYS=2026-01-01,2026-01-06,...  # festivos (formato YYYY-MM-DD, coma)
# TRANSLATOR_COLLABORATORS=  # JSON array de colaboradores
